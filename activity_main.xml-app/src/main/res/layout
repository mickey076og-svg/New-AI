<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <TextView android:text="GATHEE" android:textSize="38sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <TextView android:text="Male - All-Round AI" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="30dp"/>
    <TextView android:id="@+id/statusText" android:text="Gathee is OFF" android:textSize="18sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="20dp"/>
    <Button android:id="@+id/startBtn" android:text="START Gathee - Keep ON" android:layout_width="match_parent" android:layout_height="60dp"/>
    <Button android:id="@+id/stopBtn" android:text="STOP Gathee" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="10dp"/>
    <Button android:id="@+id/notifBtn" android:text="Enable Message Reading" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="20dp"/>
</LinearLayout>
